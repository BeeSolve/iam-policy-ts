{
  "name": "@beesolve/iam-policy-ts",
  "version": "0.1.0",
  "description": "Type-safe IAM policy helpers with auto-generated action catalog from AWS",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.js.map"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "rm -rf dist-test && tsc -p tsconfig.test.json --outDir dist-test && node --test dist-test/**/*.test.js",
    "generate": "node scripts/generate-catalog.ts",
    "prepack": "npm run generate && npm run build"
  },
  "keywords": [
    "aws",
    "iam",
    "policy",
    "typescript",
    "autocomplete",
    "valibot"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BeeSolve/iam-policy-ts.git"
  },
  "author": "BeeSolve",
  "license": "MIT",
  "dependencies": {
    "valibot": "^1.4.0"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "typescript": "^6.0.3"
  }
}
